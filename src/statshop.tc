import loops;

namespace statShopIcon {
    schema: namespace {
        material: str;
        name: str;
        stat: str;
        basePrice: num = 0;
        amount: num = 1;
        priceScaling: num = 1.15;
        prestigeEvery: num = -1;
        polynomialPrice: list[num] = [];
        maxLevel: num = 50;
        priceBrackets: list[num] = [];
        levelReq: num = 0;
        description: list[str] = [];
    };
}


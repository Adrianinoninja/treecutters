import sweeping;

type trail_beam_anim: {
    uuid: str,
    opacity: num
};

declare global "%uuid trailBeams": list[trail_beam_anim];

namespace throwingaxe {
    process throw(
        origin: loc,
        target: loc = loc(0, 0, 0)
    ) {
        player.sendAttackAnimation();

        player.playSound(snd("Trident Throw"), source = "Players");
        player.playSound(snd("Armor Equip (Leather)"), source = "Players");
        player.playSound(snd("Player Attack (Sweep)"), source = "Players");

        game.spawnItemDisplay(origin, item("iron_axe"));
        lastEntity.setTag("owner", "%default");
        line disp = lastEntity.uuid;

        line playerLoc = player.location;
        playerLoc.pitch = 0;
        playerLoc.yaw = 0;

        line dir = playerLoc.getDirection();


        line pos = origin;


        if(target.x != 0) {
            dir = vec.between(playerLoc, target).setLength(1);
            pos = pos.setDirection(dir);
        }

        line dy = 0.0;

        line f0 = vec(0, 0, 1);
        f0 = f0.rotateAroundAxis(-90, axis = "Y", unit = "Degrees");
        line s0 = vec(1, 0, 0);
        s0 = s0.rotateAroundAxis(-90, axis = "Y", unit = "Degrees");
        line spinAngle = 0;

        select entitiesByUUID(disp);
        entity.setDisplayRotationFromEulerAngles(0, 90, 0);
        select reset;

        line dt = 0;
        line oldPos = pos;
        repeat {
            dt++;
            if(dt > 30) {
                break;
            }
            pos = pos.shiftInDirection((20 + (global "%uuid stats"["throwing_axe_speed"])) / 20, direction = "Forward");
            // pos.y -= dy;
            dy += 0.01;

            // actual breaking logic for the axe
            p1(pos, disp, dt);

            if(game.cpuUsage * 100 < 30 && dt % 3 == 1) {
                queueTrailBeam(
                    oldPos.shiftAllDirections(0, -0.25, 0),
                    pos.shiftAllDirections(0, -0.25, 0)
                );
                line oldPos = pos;
            }

            // claude came up with this math but i think it's something like
            // spin the axe visually along it's forward axis, based on the spinAngle
            line crossFD = f0.cross(dir);
            line rotAxis = crossFD.setLength(1);
            line rotAngle = num.atan2(crossFD.len(), f0.dot(dir));
            spinAngle += 28;

            select entitiesByUUID(disp);
            entity.setDisplayTeleportDuration(1);
            entity.setDisplayInterpolation(1);
            entity.teleport(pos);
            // here we apply the rotations in the order
            // we use mc's builtin left/right rotation so we don't have to
            // do a bunch of weird vector math to get it in one rotation
            // the axe is never scaled so the difference is only in ordering
            entity.setDisplayRotationFromAxisAngle(
                rotAxis,
                rotAngle,
                rotationType = "Left Rotation"
            );
            entity.setDisplayRotationFromAxisAngle(
                s0,
                spinAngle,
                rotationType = "Right Rotation"
            );
            select reset;

            wait(1);
        }

        select entitiesByUUID(disp);
        entity.remove();
        select reset;
    }

    // extracted into seperate function to prevent lagslays
    // if the function needs to be modified
    function p1(
        pos: loc,
        disp: str,
        dt: var[num]
    ) {
        if(game.ticksSinceStartup % 2 == 1) {
            for(line adj of adjacent(pos.align(), pattern = "Cube (26 blocks)", includeOrigin = "True", changeLocRot = "False")) {
                adj = adj.align();
                if(woodTypeList.contains(item(game.getBlockMaterial(adj)))) {
                    select entitiesByUUID(disp);
                    selectedEntity.remove();
                    select reset;
                    execBreak(pos);
                    dt = 30;
                }
            }

            if(game.getBlockMaterial(pos.align()) != "air") {
                dt = 30;
            }
        }
    }

    // spawns a text display that acts as a line between two locations,
    // then queues it into the shared runTrailBeamAnims loop to fade out over time,
    // rather than starting a dedicated process per segment.
    // the text spawns at the source, faces towards the target,
    // and the scale is adjusted such that it intercepts the two points
    // we apply a transform to center it, allowing it to look smooth
    function queueTrailBeam(
        source: loc,
        target: loc
    ) {
        line dist = source.getDistance(target) * 5;
        game.spawnTextDisplay(source, s"<#cccccc>█");
        lastEntity.setTag("owner", "%default");
        line uuid = lastEntity.uuid;

        select entitiesByUUID(uuid);
        entity.faceLocation(target);
        entity.setTextDisplayBackground(0);
        entity.setTextDisplayTextOpacity(50);
        entity.setDisplayBillboard("type" = "Fixed");

        // set up the entity's scale to stretch between the two positions
        line scale = vec(1, dist, 1);
        entity.setDisplayScale(scale);
        entity.setDisplayRotationFromEulerAngles(90, 0, 0);

        // magic centering alignment translation
        line translation = vec.rotateAroundAxis(vec(-0.13, 0.01, 0.0), 90);
        entity.setDisplayTranslation(translation);
        select reset;

        global "%uuid trailBeams".append({
            uuid: uuid,
            opacity: 50
        } as trail_beam_anim);
    }

    process runTrailBeamAnims() {
        line stillFading: list[trail_beam_anim] = [];
        for(line beam of global "%uuid trailBeams") {
            beam["opacity"] = beam["opacity"] - 2;
            select entitiesByUUID(beam["uuid"]);
            if(beam["opacity"] <= 0) {
                entity.remove();
            } else {
                entity.setTextDisplayTextOpacity(beam["opacity"]);
                stillFading.append(beam);
            }
            select reset;
        }
        global "%uuid trailBeams" = stillFading;
    }

    function execBreak(
        pos: loc
    ) {
        line ls = str.setToString(global woodTypeList);
        for(line adj of adjacent(pos, pattern = "Cube (26 blocks)", includeOrigin = "True")) {
            adj = adj.align(align = "Block center", rotation = "Remove rotation", coords = "All coordinates");
            line mat = game.getBlockMaterial(adj);
            if(!(ls.contains(mat))) {
                continue;
            }
            line blocks = sweeping.getBlockOrders(
                (global "%uuid stats")["tree_type"], 
                adj,
                (global "%uuid stats")["sweep"],
                global "%uuid firstStrike",
                (global "%uuid stats")["timber"],
            );

            global "%uuid firstStrike" = 0;
            sweeping.safeBreak(adj);
            sweeping.executeSweep(saved "%uuid logs", blocks);
            break;
        }
    }
}
import treegens;
import util;

namespace treegens {
    mega = "mega";
    big = "big";
    medium = "medium";
    small = "small";
    tiny = "tiny";

    oak = "oak";
    dark = "dark";
    cherry = "cherry";
    warped = "warped";
    molten = "molten";
    aerial = "aerial";
    lunar = "lunar";
    solar = "solar";
    astral = "astral";
    yggdrasil = "yggdrasil";


    infinite = "infinite";

    function growArbitraryTree(
        idx: num,
        treeType: str = "default"
    ): list[loc] {
        line individualSize = [tiny, small, medium, big, mega][(idx % 5) + 1];
        if(idx >= 55) {
            individualSize = "mega";
        }
        if(treeType == "default") {
            line treeType = [
                oak, dark, cherry, warped, molten, aerial, lunar, solar, astral, yggdrasil, 
                infinite, infinite, infinite, infinite, infinite, infinite, infinite, infinite, infinite, infinite, infinite, 
                infinite, infinite, infinite, infinite, infinite, infinite, infinite, infinite, infinite, infinite, infinite,
                infinite, infinite, infinite, infinite, infinite, infinite, infinite, infinite, infinite, infinite, infinite, 
                infinite, infinite, infinite, infinite, infinite, infinite, infinite, infinite, infinite, infinite, infinite
            ][(idx / 5) + 1];
        }

        line pos = global "%uuid roomPos".shiftAllAxes(
            num.random(-3, 3),
            -1,
            num.random(-3, 3),
        );

        if(treeType == oak) {
            return treegens.buildOakTree(
                pos,
                individualSize
            );
        }
        if(treeType == dark) {
            return treegens.buildDarkTree(
                pos,
                individualSize
            );
        }
        if(treeType == cherry) {
            return treegens.buildCherryTree(
                pos,
                individualSize
            );
        }
        if(treeType == warped) {
            return treegens.buildWarpedTree(
                pos,
                individualSize
            );
        }
        if(treeType == molten) {
            return treegens.buildMoltenTree(
                pos,
                individualSize
            );
        }
        if(treeType == aerial) {
            return treegens.buildAerialTree(
                pos,
                individualSize
            );
        }
        if(treeType == lunar) {
            return treegens.buildLunarTree(
                pos,
                individualSize
            );
        }
        if(treeType == solar) {
            return treegens.buildSolarTree(
                pos,
                individualSize
            );
        }
        if(treeType == astral) {
            return treegens.buildAstralTree(
                pos,
                individualSize
            );
        }
        if(treeType == yggdrasil) {
            return treegens.buildYggdrasilTree(
                pos,
                individualSize
            );
        }
        if(treeType == infinite) {
            line treeTypeSel: str = var.setToRandom(
                oak,
                dark,
                cherry,
                warped,
                aerial,
                solar,
                astral,
                yggdrasil
            );
            return growArbitraryTree(idx, treeTypeSel);
        }
        return [];
    }

    process growForPlayer() {
        if(global "%uuid treeRegenerating" == 1) {
            endthread;
        } 

        declare global "%uuid treeRegenerating" = 1;
        wait(20);

        global "%uuid brokenLogs" = [];
        declare global "%uuid blocksToBreak" = treegens.growArbitraryTree(global "%uuid stats"["tree_type"]);
        player.playSound(snd("Creaking Attack"));   
        global "%uuid treeRegenerating" = 0;
    }

    function sizeVariables(
        size: str
    ): [list[vec], num, num] {
        line log_positions: list[vec];
        line height: num;
        line branchReqs: num;
        if(size == tiny) {
            log_positions = [
                vec(0, 0, 0)
            ];
            height = num.random(4, 5);
            branchReqs = 2;
        }  
        if(size == small) {
            log_positions = [
                vec(0, 0, 0),
                vec(0, 0, 1),
                vec(1, 0, 0),
                vec(1, 0, 1)
            ];
            height = num.random(6, 9);
            branchReqs = 3;
        }
        if(size == medium) {
            log_positions = [
                vec(0, 0, 0),
                vec(0, 0, 1),
                vec(1, 0, 0),
                vec(1, 0, 1),
                vec(1, 0, -1),
                vec(-1, 0, 1),
                vec(0, 0, -1),
                vec(-1, 0, 0),
                vec(-1, 0, -1)
            ];
            height = num.random(7, 10);
            branchReqs = 3;
        }   
        if(size == big) {
            log_positions = [
                vec(0, 0, 0),
                vec(0, 0, 1),
                vec(1, 0, 0),
                vec(1, 0, 1),
                vec(1, 0, -1),
                vec(-1, 0, 1),
                vec(0, 0, -1),
                vec(-1, 0, 0),
                vec(-1, 0, -1)
            ];
            height = num.random(10, 13);
            branchReqs = 4;
        }
        if(size == mega) {
            log_positions = [
                vec(0, 0, 0),
                vec(0, 0, 1),
                vec(1, 0, 0),
                vec(1, 0, 1),
                vec(1, 0, -1),
                vec(-1, 0, 1),
                vec(0, 0, -1),
                vec(-1, 0, 0),
                vec(-1, 0, -1),
                vec(2, 0, 0),
                vec(-2, 0, 0),
                vec(0, 0, 2),
                vec(0, 0, -2)
            ];
            height = num.random(12, 14);
            branchReqs = 6;
        }  
        return [log_positions, height, branchReqs];
    }

    function buildBranches(
        outputPositions: var[list[loc]],
        root: loc,
        length: num,
        branches: num,
        targetYOff: num,
        centerDistance: num,
        mat: item
    ): list[loc] {
        line iterations = 0;
        line yawOffset = num.random(0, 360);
        line yawDiff = 360 / branches;
        line endcaps: list[loc] = [];
        for(line idx of range(1, branches)) {
            line yaw = yawOffset + (yawDiff * idx);
            line pitch = num.random(-30, 30);
            line rootCopy = root.shiftAllDirections(0, 0, 0);
            rootCopy.yaw += yaw;
            rootCopy.shiftInDirection(centerDistance, direction = "Forward");
            line targetLoc = rootCopy.shiftInDirection(length, direction = "Forward");  
            targetLoc.y += targetYOff; 

            line pathPos: loc;
            for(pathPos of path(root, targetLoc, 0.25)) {
                pathPos = pathPos.align(align = "Block center", rotation = "Remove rotation", coords = "All coordinates");
                if(game.getBlockMaterial(pathPos) == "air") {
                    game.setBlock(mat, pathPos);
                    outputPositions.append(pathPos);
                    player.playSound(snd("Wood Place"), pathPos);
                    util.fastWait(1/(global "%uuid stats"["tree_growth"]));
                }
            }
            endcaps.append(pathPos);
        }
        return endcaps;
    }

    function buildTrunk(
        outputPositions: var[list[loc]],
        root: loc,
        height: num,
        logPositions: list[vec],
        mat: item
    ) {
        for(line i of range(0, height)) {
            for(line offset of logPositions) {
                line added = root.shiftOnVector(offset);
                added = added.align(align = "Block center", rotation = "Remove rotation", coords = "All coordinates");
                if(game.getBlockMaterial(added) != "air") {
                    continue;
                }
                game.setBlock(mat, added);
                player.playSound(snd("Wood Place"), added);
                outputPositions.append(added);
                util.fastWait(1/(global "%uuid stats"["tree_growth"]));
            }
            root.y += 1;
        }
    }


    function buildOakTree(
        root: loc,
        size: str
    ): list[loc] {
        line svars = sizeVariables(size);
        line logPositions = svars[1];
        line height = svars[2];
        line branchReqs = svars[3];
        line outputPositions: list[loc] = [];
         
        buildTrunk(
            outputPositions,
            root,
            height,
            logPositions,
            item("stripped_oak_wood")
        );

        root.y += height;

        buildBranches(
            outputPositions,
            root,
            height / 2,
            branchReqs,
            num.random(-2, 2),
            0,
            item("stripped_oak_wood")
        );
        outputPositions = outputPositions.removeDuplicates() as list[loc];
        outputPositions.removeAir();
        return outputPositions;
    }

    function buildDarkTree(
        root: loc,
        size: str
    ): list[loc] {
        line svars = sizeVariables(size);
        line logPositions = svars[1];
        line height = svars[2];
        line branchReqs = svars[3];
        line outputPositions: list[loc] = [];

        root.y += 5;

        buildBranches(
            outputPositions,
            root,
            6,
            branchReqs,
            -5,
            0,
            item("stripped_spruce_wood")
        );

        root.y -= 5;
    
        buildTrunk(
            outputPositions,
            root,
            height,
            logPositions,
            item("stripped_spruce_wood")
        );

        root.y += height;

        buildBranches(
            outputPositions,
            root,
            height * 0.75,
            branchReqs,
            num.random(-3, 3),
            0,
            item("stripped_spruce_wood")
        );

        outputPositions = outputPositions.removeDuplicates() as list[loc];
        outputPositions.removeAir();
        return outputPositions;
    }



    function buildCherryTree(
        root: loc,
        size: str
    ): list[loc] {
        line svars = sizeVariables(size);
        line logPositions = svars[1];
        line height = svars[2];
        line branchReqs = svars[3];
        line outputPositions: list[loc] = [];
        line dx = num.random(-1, 1);
        line dz = num.random(-1, 1);

        for(line part of range(1, 4)) {
            buildTrunk(
                outputPositions,
                root,
                height / 4,
                logPositions,
                item("stripped_cherry_wood")
            );

            root.y += height / 4;
            root.x += dx;
            root.z += dz;

            root = root.align(align = "Block center", rotation = "Remove rotation", coords = "All coordinates");
        }
        

        buildBranches(
            outputPositions,
            root,
            height * 0.8,
            branchReqs,
            num.random(-3, 3),
            0,
            item("stripped_cherry_wood")
        );

        outputPositions = outputPositions.removeDuplicates() as list[loc];
        outputPositions.removeAir();
        return outputPositions;
    }

    function buildWarpedTree(
        root: loc,
        size: str
    ): list[loc] {
        line svars = sizeVariables(size);
        line logPositions = svars[1];
        line height = svars[2];
        line branchReqs = svars[3];
        line outputPositions: list[loc] = [];
        line dx = num.random(-1, 1);
        line dz = num.random(-1, 1);

        buildTrunk(
            outputPositions,
            root,
            height / 2,
            logPositions,
            item("stripped_warped_stem")
        );

        root.y += height / 2;

        line endcaps = buildBranches(
            outputPositions,
            root,
            height * 0.6,
            branchReqs,
            num.random(2, 4),
            0,
            item("stripped_warped_stem")
        );

        for(line endcap of endcaps) {
            buildTrunk(
                outputPositions,
                endcap,
                height / 2,
                logPositions,
                item("stripped_warped_stem")
            );
            endcap.y += height / 2;
            buildBranches(
                outputPositions,
                endcap,
                height * 0.1,
                branchReqs,
                num.random(2, 4),
                0,
                item("stripped_warped_stem")
            );
        }

        outputPositions = outputPositions.removeDuplicates() as list[loc];
        outputPositions.removeAir();
        return outputPositions;
    }




    function buildMoltenTree(
        root: loc,
        size: str
    ): list[loc] {
        line svars = sizeVariables(size);
        line logPositions = svars[1];
        line height = svars[2];
        line branchReqs = svars[3];
        line outputPositions: list[loc] = [];

        buildTrunk(
            outputPositions,
            root,
            height,
            logPositions,
            item("stripped_crimson_stem")
        );

        line root2 = root;
        for(line x of range(0, height, 3)) {
            root2.y += 3;
            buildBranches(
                outputPositions,
                root2,
                height * 0.7,
                branchReqs,
                num.random(-1, -3),
                0,
                item("stripped_crimson_stem")
            );
        }

        outputPositions = outputPositions.removeDuplicates() as list[loc];
        outputPositions.removeAir();
         
        
        return outputPositions;
    }

    function buildAerialTree(
        root: loc,
        size: str
    ): list[loc] {
        line svars = sizeVariables(size);
        line logPositions = svars[1];
        line height = svars[2];
        line branchReqs = svars[3];
        line outputPositions: list[loc] = [];

        buildTrunk(
            outputPositions,
            root,
            height,
            logPositions,
            item("stripped_pale_oak_wood")
        );


        root.y += height;

        line endcaps = buildBranches(
            outputPositions,
            root,
            height * 0.7,
            branchReqs,
            num.random(-1, -3),
            0,
            item("stripped_pale_oak_wood")
        );

        for(line endcap of endcaps) {
            buildBranches(
                outputPositions,
                endcap,
                num.random(2, 3),
                1,
                num.random(-height * 0.6, -height * 0.8),
                0,
                item("stripped_pale_oak_wood")
            );
            
        }
        outputPositions = outputPositions.removeDuplicates() as list[loc];
        outputPositions.removeAir();
        
        return outputPositions;
    }

    function buildLunarTree(
        root: loc,
        size: str
    ): list[loc] {
        line svars = sizeVariables(size);
        line logPositions = svars[1];
        line height = svars[2];
        line branchReqs = svars[3];
        line outputPositions: list[loc] = [];

        buildTrunk(
            outputPositions,
            root,
            height,
            logPositions,
            item("pale_oak_wood")
        );


        root.y += height;

        line endcaps = buildBranches(
            outputPositions,
            root,
            height * 0.6,
            branchReqs,
            num.random(2, 4),
            0,
            item("pale_oak_wood")
        );

        for(line endcap of endcaps) {
            buildBranches(
                outputPositions,
                endcap,
                height * 0.5,
                branchReqs,
                num.random(2, 4),
                0,
                item("pale_oak_wood")
            );
            
        }
        outputPositions = outputPositions.removeDuplicates() as list[loc];
        outputPositions.removeAir();
        
        return outputPositions;
    }

    function buildSolarTree(
        root: loc,
        size: str
    ): list[loc] {
        line svars = sizeVariables(size);
        line logPositions = svars[1];
        line height = svars[2];
        line branchReqs = svars[3];
        line outputPositions: list[loc] = [];

        line dt = num.random(0, 3.14);
        line lastRoot = root;
        for(line t of range(0, height, 0.4)) {
            line dx = (t + dt).cos(unit = "Radians") * 4;
            line dy = (t + dt).sin(unit = "Radians") * 4;
            lastRoot = root.shiftAllAxes(dx, t, dy);
            buildTrunk(
                outputPositions,
                lastRoot,
                1,
                logPositions,
                item("stripped_birch_wood")
            );
        }

        line endcaps = buildBranches(
            outputPositions,
            lastRoot,
            height * 0.6,
            branchReqs,
            num.random(2, 4),
            0,
            item("stripped_birch_wood")
        );

        outputPositions = outputPositions.removeDuplicates() as list[loc];
        outputPositions.removeAir();
        
        return outputPositions;
    }

    function buildAstralTree(
        root: loc,
        size: str
    ): list[loc] {
        line svars = sizeVariables(size);
        line logPositions = svars[1];
        line height = svars[2];
        line branchReqs = svars[3];
        line outputPositions: list[loc] = [];

        line dt = num.random(0, 3.14);
        line lastRoot = root;
        for(line t of range(0, height * 1.2, 0.4)) {
            line dx = (t + dt).cos(unit = "Radians") * 2;
            line dy = (t + dt).sin(unit = "Radians") * 2;
            lastRoot = root.shiftAllAxes(dx, t, dy);
            buildTrunk(
                outputPositions,
                lastRoot,
                1,
                logPositions,
                item("stripped_dark_oak_wood")
            );
            if(t % 4 == 1.2) {
                buildBranches(
                    outputPositions,
                    lastRoot,
                    num.min(height * 0.7, 6),
                    branchReqs,
                    num.random(1, 2),
                    0,
                    item("stripped_dark_oak_wood")
                );
            }
        }

        line endcaps = buildBranches(
            outputPositions,
            lastRoot,
            height * 0.7,
            branchReqs,
            num.random(2, 4),
            0,
            item("stripped_dark_oak_wood")
        );

        outputPositions = outputPositions.removeDuplicates() as list[loc];
        outputPositions.removeAir();
        
        return outputPositions;
    }



    function buildYggdrasilTree(
        root: loc,
        size: str
    ): list[loc] {
        line svars = sizeVariables(size);
        line logPositions = svars[1];
        line height = svars[2];
        line branchReqs = svars[3];
        line outputPositions: list[loc] = [];

        line dt = num.random(0, 3.14);
        line lastRoot = root;


        for(line t of range(0, height * 1.2, 0.4)) {
            line dx = (t + dt).cos(unit = "Radians") * 2;
            line dy = (t + dt).sin(unit = "Radians") * 2;
            lastRoot = root.shiftAllAxes(dx, t, dy);
            buildTrunk(
                outputPositions,
                lastRoot,
                1,
                logPositions,
                item("oak_wood")
            );
            line midRoot = root.shiftAllAxes(0, t, 0);
            buildTrunk(
                outputPositions,
                midRoot,
                1,
                logPositions,
                item("oak_wood")
            );
            if(t % 4 == 1.2) {
                buildBranches(
                    outputPositions,
                    lastRoot,
                    num.min(height * 0.7, 6),
                    branchReqs,
                    num.random(1, 2),
                    0,
                    item("oak_wood")
                );
            }
        }

        line endcaps = buildBranches(
            outputPositions,
            lastRoot,
            height * 0.7,
            branchReqs,
            num.random(2, 4),
            0,
            item("oak_wood")
        );

        outputPositions = outputPositions.removeDuplicates() as list[loc];
        outputPositions.removeAir();
        
        return outputPositions;
    }
}

extend list[loc] {
    function removeAir(this: var[list[loc]]) {
        for(line block of this) {
            if(game.getBlockMaterial(block) == "air" || game.getBlockMaterial(block) == "light") {
                this.removeValue(block);
            }
        }
    }
}
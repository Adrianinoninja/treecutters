import sweeping;
import throwingaxe;

namespace abils {
    function turret() {
        if(game.ticksSinceStartup % (80 - global "%uuid stats"["turret"]) == 0 && global "%uuid stats"["turret"] > 0) {
            line diff = global "%uuid blocksToBreak";
            diff.removeValue(global "%uuid brokenLogs");

            line rngBlock = var.setToRandom(diff) as loc;

            if(rngBlock == 0) {
                return;
            }

            line blocks = sweeping.getBlockOrders(
                (global "%uuid stats")["tree_type"],
                rngBlock,
                (global "%uuid stats")["sweep"]
            );
            line t2: list[loc] = blocks.flatten();
            t2 = t2.trim(1, (t2.len().root(1.5)) + 1) as list[loc];

            line l1 = player.midpointLocation;
            line l2 = rngBlock;
            // start throwingaxe.spawnTemporaryBeam(l1, l2);

            sweeping.safeBreak(rngBlock);
            sweeping.executeSweepFlattened(saved "%uuid logs", t2);
        }
    }
}
import treegens;
import util;

type log_family: {
    value: num,
    toughness: num,
    name: str
};

extend log_family {
    function constructor(value: num, toughness: num, name: str): log_family {
        return { value: value, toughness: toughness, name: name } as log_family;
    }
}

namespace sweeping {
    function getBlockOrders(
        tier: num,
        origin: loc,
        maxBlocks: num,
        firstStrike: num = 0,
        timberLevel: num = 0
    ): list[list[loc]] {
        line logFamily = global log_families[num.floor(tier / 5) + 1];
        maxBlocks = maxBlocks - logFamily["toughness"];
        if(maxBlocks > 8) {
            maxBlocks = 8 + ((maxBlocks - 8) * 0.5);
        }
        if(maxBlocks > 16) {
            maxBlocks = 16 + ((maxBlocks - 16) * 0.5);
        }
        if(maxBlocks > 32) {
            maxBlocks = 32 + ((maxBlocks - 32) * 0.5);
        }


        if(firstStrike == 1) {
            if(num.random(1, 100) <= timberLevel) {
                player.sendTitle(s"", s"<green><bold>TIMBER!", 10, 1, 1);
                player.playSound(snd("Axe Strip"));
                maxBlocks = 10000;
            }
        }

        line breakQueue: list[list[loc]] = [];
        line currentBlockList: list[loc] = [origin];
        line breaksNextTick: list[loc] = [];
        line brokenBlocks = [];
        line blocksMined = 0;

        line ls = str.setToString(global woodTypeList);

        while(blocksMined < maxBlocks) {
            if(currentBlockList.sizeEquals(0)) {
                if(breaksNextTick.sizeEquals(0)) {
                    break;
                }

                breakQueue.append(breaksNextTick);
                currentBlockList = breaksNextTick;
                breaksNextTick = [];
            }

            line el = currentBlockList.pop(num.random(1, currentBlockList.len()));
            for(line offset of sweepVecs) {
                line adj = el.shiftAllAxes(offset.x, offset.y, offset.z);
                line mat = game.getBlockMaterial(adj);
                if(!brokenBlocks.contains(adj) && mat != "air" && ls.contains(mat)) {
                    breaksNextTick.append(adj);
                    brokenBlocks.append(adj);
                }   
            }
            blocksMined++;
        }

        return breakQueue;
    }

    function executeSweep(
        incrementOnBlock: var[num],
        blocks: list[list[loc]]
    ): num {
        line flat = blocks.flatten();
        flat.removeDuplicates();

        line blocksPerTick =  (flat.len() / 10);
        for(line block of flat) {
            safeBreak(block);
            util.fastWait(1/blocksPerTick);
        }
    }

    function executeSweepFlattened(
        incrementOnBlock: var[num],
        blocks: list[loc]
    ): num {
        blocks.removeDuplicates();

        line blocksPerTick =  (blocks.len() / 10);
        for(line block of blocks) {
            safeBreak(block);
            util.fastWait(1/blocksPerTick);
        }
    }

    function safeBreak(
        block: loc
    ) {
        block = block.align(align = "Block center", rotation = "Remove rotation", coords = "All coordinates");
        if(global "%uuid treeRegenerating" == 1) {
            event.cancel();
            return;
        }
        line logValue = log_families[num.floor(global "%uuid stats"["tree_type"]/5)+1]["value"];
        logValue *= global "%uuid stats"["fortune"] + 1;

        if(weatherType == 1) {
            logValue *= 1.1;
        }
        if(weatherType == 2) {
            logValue *= 1.3;
        }
        if(weatherType == 3) {
            logValue *= 1.5;
        }
        if(weatherType == 4) {
            logValue *= 2;
        }

        line mat = game.getBlockMaterial(block);
        if(mat != "air" && mat != "light" && !global "%uuid brokenLogs".contains(block)) {
            global "%uuid brokenLogs".append(block);
            saved "%uuid logs" += logValue;
            declare saved "%uuid true_logs" += 1;
        }
        if(saved "%uuid settings"["logEffects"] == "Enabled") {
            game.breakBlock(block);
        } else {
            game.setBlock("air" as item, block);
        }
        
        start blockFallAnim(block, mat);

        line brokenSoFar = global "%uuid brokenLogs".len();
        line brokenReq = global "%uuid blocksToBreak".len();
        if(
            brokenSoFar / brokenReq >= 0.9 - global "%uuid stats"["cutoff_rate"]
        ) {
            start treeClearAnim(block);
            for(line block2 of global "%uuid blocksToBreak") {
                line mat2 = game.getBlockMaterial(block2);
                if(mat2 != "air" && !global "%uuid brokenLogs".contains(block2)) {
                    global "%uuid brokenLogs".append(block2);
                    saved "%uuid logs" += logValue;
                    saved "%uuid true_logs" += 1;
                    if(game.cpuUsage * 100 < 30) {
                        start blockFallAnim(block2, mat);
                    }
                }
                if(saved "%uuid settings"["logEffects"] == "Enabled") {
                    game.breakBlock(block2);
                } else {
                    game.setBlock("air" as item, block2);
                }
            }
            player.playSound(snd("Creaking Activate", 1, 0.5));
            start treegens.growForPlayer();
        }
    }

    process treeClearAnim(
        pos: loc
    ) {
        line pitch = -90;
        if(default.eyeLocation.y > pos.y) {
            pitch = 90;
        }
        pos = pos.align(align = "Block center", rotation = "Remove rotation", coords = "All coordinates");
        game.spawnTextDisplay(pos, s"☐");
        line disp = lastEntity.uuid;

        allPlayers.setEntityHidden(disp);
        default.setEntityHidden(disp, hidden = "Disable");

        select entitiesByName(disp);
        selectedEntity.setDisplayRotationFromEulerAngles(pitch, 0, 0);
        selectedEntity.setDisplayBillboard("type" = "Fixed");
        selectedEntity.setTextDisplayBackground("#000000", 0);
        for(line idx of range(0, 100, 10)) {
            selectedEntity.setDisplayInterpolation(1, 0);
            selectedEntity.setTextDisplayTextOpacity((100 - idx) / 2);
            selectedEntity.setDisplayScale(idx * 2, idx * 2, idx * 2);
            line translation = vec(-0.02, 0, -0.13).multiply(idx * 2);
            selectedEntity.setDisplayTranslation(translation);
            wait(1);
        }
        selectedEntity.remove();
        select reset;

    }

    process blockFallAnim(
        block: loc,
        mat: str
    ) {
        if(saved "%uuid settings"["logEffects"] == "Disabled") {
            endthread;
        }
        block = block.align(align = "Block center", rotation = "Remove rotation", coords = "All coordinates");
        game.spawnItemDisplay(block, item(mat));
        line uuid = lastEntity.uuid;

        line xOff = num.random(-2, 2, rounding = "Decimal number");
        line zOff = num.random(-2, 2, rounding = "Decimal number");


        line pitchOff = num.random(-90, 90, rounding = "Decimal number");
        line yawOff = num.random(-90, 90, rounding = "Decimal number");
        line rollOff = num.random(-90, 90, rounding = "Decimal number");

        line tempLoc = block;
        while(game.getBlockMaterial(tempLoc) != "water" && game.getBlockMaterial(tempLoc) != "grass_block") {
            tempLoc.y -= 1;
            if(tempLoc.y < 0) {
                select entitiesByUUID(uuid);
                selectedEntity.remove();
                select reset;
                endthread;
            }
        }

        line distDown = num.abs(block.y - tempLoc.y);
        line distTime = num.ceil(distDown * 3);

        wait(1);
        select entitiesByUUID(uuid);

        entity.setDisplayTeleportDuration(distTime);
        entity.setDisplayInterpolation(distTime);
        wait(1);
        entity.teleport(block.shiftAllAxes(xOff, -distDown, zOff));
        entity.setDisplayRotationFromEulerAngles(pitchOff, yawOff, rollOff);
        wait(distTime);
        entity.remove();
        
        
        select reset;
    }

    function logCap(tier: num): num {
        return [
            2000,
            6000,
            18000,
            30000,
            45000,
            70000,
            120000,
            170000,
            240000
        ][num.min(num.floor(tier/5),7)+1];
    }
}
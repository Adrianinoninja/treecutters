import statShopIcon;
import trinket;

namespace stats {
    // stats basically power every mechanic in the game based on upgrades
    // e.g timber, sweep, fortune, etc.
    function computeStats() {
        line stats: dict[num] = {};

        stats["sweep"] = 0;
        stats["tree_growth"] = 1;

        for(line iconKey of namespace.getKeys(statShopIcon)) {
            line level = saved "%uuid statShop"[iconKey];
            line stat = statShopIcon[iconKey].stat;
            line amount = statShopIcon[iconKey].amount;
            stats[stat] += amount * level;
        }

        if(var.exists(saved "%uuid trinketSelections") && var.exists(saved "%uuid trinketInventory")) {
            for(line rngId of saved "%uuid trinketSelections") {
                if(rngId == 0) {
                    continue;
                }

                line entry = saved "%uuid trinketInventory"["%var(rngId)"];

                for(line stat, line amount of trinket[entry["id"]].stats) {
                    stats[stat] += amount * entry["level"]; // scale by trinket level
                }
            }
        }

        if(stats["jump_height"] >= 1) {
            line jumpBoostEffect = pot("Jump Boost", stats["jump_height"], 10000000);
            player.givePotionEffect(jumpBoostEffect, particles = "None", showIcon = "False");
        }

        player.setMovementAttribute(0.2 + (stats["walk_speed"] * 0.02), attr = "Walking speed", valueType = "Direct");

        player.setReachAttribute(4 + stats["swing_range"], attr = "Block interaction range", valueType = "Direct");

        global "%uuid stats" = stats;
    }
}
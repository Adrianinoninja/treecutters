import stats;
import util;

playerevent chat {
    if(chatGameSolution.len() != 0 && event.message.matches(global chatGameSolution)) {
        allPlayers.sendMessage(s"<green><bold>WINNER! <reset><aqua>%default <gray>got the answer of %var(chatGameSolution)!");
        line logValue = log_families[num.floor(global "%uuid stats"["tree_type"]/5)+1]["value"];
        line logInc = logValue * ((num.floor(global "%uuid stats"["tree_type"]%5)+1) * 225);
        if(global "%uuid stats"["tree_type"] >= 55) {
            line logInc = logValue * (6 * 225);
        }
        
        // birthday
        logInc = logInc * 1.15;

        line logRender = util.numberFormat(logInc);
        allPlayers.sendMessage(s"<dark_gray>The person earned %var(logRender) logs!");
        chatGameSolution = "";
        saved "%uuid logs" += logInc;
        declare global hintType: num = 0;
        declare saved "%uuid chat_wins": num += 1;
    }
    if(global hintType == 1) {
        line realVal = num.parse(chatGameSolution);
        line checkVal = num.parse(event.message);
        if(checkVal != 0) {
            if(checkVal < realVal) {
                player.sendMessage(s"<gray>The guess %var(checkVal) is too small.");
            } else {
                player.sendMessage(s"<gray>The guess %var(checkVal) is too big.");
            }
        }
    }
}

namespace loops {
    process executePlayerLoops() {
        repeat {
            select allPlayers;
            start playerLoop(targetMode = "For each in selection");
            select reset;

            if(game.ticksSinceStartup % 1000 == 0) {
                setupChatGame();
            }

            wait(1);
        }
    }

    function generateScoreboard() {
        if(game.timestamp - lastTime > 3) {
            declare global lastTime: num = game.timestamp;

            declare global tl = s"\n<green><bold>TREECUTTING<reset>\n\n\n";
            line players: dict[num] = {};
            line logs: dict[num] = {};
            for(line playerUuid of game.plotPlayerUUIDs) {
                select playersByName(playerUuid);
                players[selected.name.clearFormatting()] = global "%uuid stats"["tree_type"];
                logs[selected.name.clearFormatting()] = saved "%uuid logs";
                select reset;
            }
            players = players.sort("type" = "Sort by Value", order = "Descending");
            for(line player, line level of players) {
                line lc = util.numberFormat(logs[player]);
                line tag = createChatTag(level);
                tl += s"%var(tag) <#dddddd>%var(player) <dark_gray>%var(lc)<reset>\n";
            }

            line cpu = game.cpuUsage * 100;
            line pc = game.playerCount;
            tl += s"\n<gray>Players Online: <aqua>%var(pc)\n";
            tl += s"<gray>CPU Usage: <green>%var(cpu)<dark_green>%\n";

            if(game.cpuUsage * 100 > 40) {
                tl += s"<red>LAG: Some visual effects have been disabled for performance.\n";
            }

            if(game.cpuUsage * 100 > 60) {
                tl += s"<red>LAG: Speed-based animations been slowed down for performance.\n";
            }

            tl = tl + s"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n";
            
            allPlayers.setTabListInfo(tl, field = "Header");
        }
    }
    
    process playerLoop() {
        if(game.ticksSinceStartup % (60 * 20) == 0) {
            line tip: str = var.setToRandom(
                "You can Swap Hands to open your upgrde menu!",
                "You can double jump mid-air, if you have a high enough Jump Boost!",
                "The game is completely open-source at https://github.com/akarahdev/treecutters"
            );
            player.sendMessage(s"<gold><bold>DID YOU KNOW? <reset><gray>%var(tip)");
        }
        if(game.ticksSinceStartup % 5 == global "%uuid hashCode" % 5) {
            line brokenSoFar = global "%uuid brokenLogs".len();
            line brokenReq = global "%uuid blocksToBreak".len();
            line totalPerc = ((brokenSoFar / (brokenReq * 0.9)) * 100).round().min(100);
            line fmtLogs = util.numberFormat(saved "%uuid logs");
            player.sendActionBar(s"<dark_green>╟ <green>%var(fmtLogs) Logs <dark_gray>| <gray>%var(totalPerc)%");

            if(player.isGrounded()) {
                global "%uuid canDoubleJump" = 1;
            }
            
            generateScoreboard();
        }

        if(game.ticksSinceStartup % 20 == global "%uuid hashCode" % 20) {
            player.givePotionEffect(pot("Night Vision", 1, 100000), particles = "None", showIcon = "False");

            player.setSaturationLevel(20);
            player.setFoodLevel(20);

            player.setNameTagVisible(visible = "Disable");
            line lv = global "%uuid stats"["tree_type"];
            player.setChatTag(createChatTag(lv));
            player.setChatStyle(s"<#dddddd>");

            updatePlayerInv();
        }
    }

    function createChatTag(level: num): txt {
        line color = "gray";
        if(level >= 4) {
            color = "blue";
        }
        if(level >= 9) {
            color = "green";
        }
        if(level >= 14) {
            color = "yellow";
        }
        if(level >= 19) {
            color = "gold";
        }
        if(level >= 24) {
            color = "red";
        }
        if(level >= 29) {
            color = "dark_red";
        }
        if(level >= 34) {
            color = "dark_purple";
        }
        if(level >= 39) {
            color = "light_purple";
        }
        if(level >= 44) {
            color = "aqua";
        }
        if(level > 49) {
            color = "gradient:#777777:#ffffff";
        }
        if(level > 54) {
            color = "gradient:blue:aqua";
        }
        if(level > 59) {
            color = "gradient:#000099:#0000ff";
        }
        if(level > 64) {
            color = "gradient:#990099:#ff00ff";
        }
        if(level > 69) {
            color = "gradient:#660066:#cc00cc";
        }
        if(level > 74) {
            color = "gradient:#333399:#7777ff";
        }
        if(level > 79) {
            color = "gradient:#000066:#0000ff";
        }
        if(level > 84) {
            color = "gradient:#440044:#770077";
        }
        if(level > 89) {
            color = "gradient:#770077:#bb00bb";
        }
        if(level > 99) {
            color = "gradient:#555599:#aaaaff";
        }
        return txt.parseExpression("<dark_gray>[<%var(color)>%var(level)🪓<dark_gray>]");
    }

    function setupChatGame() {
        if(game.ticksSinceStartup % 3000 != 0) {
            return;
        }
        if(game.playerCount < 3) {
            return;
        }
        setupChatGameHidden();
    }

    function setupChatGameHidden() {
        declare global chatGameSolution: str = "";

        line gameType = num.random(1, 3, rounding = "Whole number");
        line gameTypeTxt: str = "";
        line gamePrompt: str = "";
        if(gameType == 1) {
            gameTypeTxt = "QUICK MATH!";

            line a = num.random(2, 20, rounding = "Whole number");
            line b = num.random(2, 20, rounding = "Whole number");
            line c = num.random(2, 20, rounding = "Whole number");
            
            line equationType = num.random(1, 3, rounding = "Whole number");
            if(equationType == 1) {
                chatGameSolution = str.setToString(a + b * c);
                gamePrompt = "Solve %var(a) + %var(b) * %var(c)";
            } else if(equationType == 2) {
                chatGameSolution = str.setToString(a * b * c);
                gamePrompt = "Solve %var(a) * %var(b) * %var(c)";
            } else if(equationType == 3) {
                chatGameSolution = str.setToString(a * b - c);
                gamePrompt = "Solve %var(a) * %var(b) - %var(c)";
            }
            gamePrompt = "Solve %var(gamePrompt).";
        }
        if(gameType == 3) {
            chatGameSolution = str.setToString(num.random(1, 200, rounding = "Whole number"));
            gameTypeTxt = "GUESS THE NUMBER!";
            gamePrompt = "A number from 1 to 200 has been selected. Guess it!";
            global hintType = 1;
        }
        if(gameType == 2) {
            line words: list[str] = [
                "apple",
                "almond",
                "aspen",
                "baobab",
                "waxed lightly weathered cut copper stairs",
                "birch",
                "bodhi",
                "bark",
                "cedar",
                "cherry",
                "coconut",
                "chestnut",
                "elderberry",
                "fir",
                "forest",
                "grove",
                "grapefruit",
                "haw",
                "holly",
                "jungle",
                "maple",
                "nectarine",
                "oak",
                "palm",
                "rainforest",
                "rubber",
                "spruce",
                "walnut",
                "willow",

                "sprout",
                "sprouting",
                "flower",
                "flowering",
                "birches",
                "felled",
                "chopped",
                "cut",
                "treecutting",
                "bonsai",
                "shrubs",
                "arboreal",
                "evergreen",
                "poplars",
                "leafless",
                "cedars",
                "grapevines",
                "deciduous",
                "undergrowth",
                "eucalyptus",
                "persimmon",
                "pines",
                "bushes",
                "fruit",
                "pruned",
                "mango",
                "dwarfed",
                "trunks",
                "leaves"
            ];
            line sel = words[num.random(1, words.len() - 1, rounding = "Whole number")];
            line scrambled: list[str] = sel.split("");
            for(line i of range(1, 20)) {
                line char1 = num.random(1, sel.len());
                line char2 = num.random(1, sel.len());
                line tmp1 = scrambled[char1];
                line tmp2 = scrambled[char2];
                scrambled[char1] = tmp2;
                scrambled[char2] = tmp1;
            }
            line outstr = scrambled.join("");
            gameTypeTxt = "QUICK SCRAMBLE!";
            gamePrompt = "Unscramble the word '%var(outstr)'!";
            chatGameSolution = sel;
        }
        if(gameType == 4) {
            gameTypeTxt = "PING WARS";
            gamePrompt = "The person with the highest ping wins!";
            chatGameSolution = "";
        }
        allPlayers.sendMessage(s"<green><bold>%var(gameTypeTxt) <reset><gray>%var(gamePrompt)");
    }

    function updatePlayerInv() {
        line logs = saved "%uuid logs";

        if(game.cpuUsage * 100 > 30) {
            logs = 0;
        }

        line basicLogs = (logs % 64);
        line enchLogs = ((logs / 64) % 64);
        line hyperEnchLogs = ((logs / 64 / 64) % 64);
        line hyperEnch2Logs = ((logs / 64 / 64 / 64) % 64);
        line hyperEnch3Logs = ((logs / 64 / 64 / 64 / 64) % 64);

        line basicLogItem = item("stripped_oak_wood", basicLogs);
        basicLogItem = basicLogItem.setName(s"");
        basicLogItem = basicLogItem.setTooltipVisible(tooltip = "Disable");

        line enchLogItem = item("stripped_oak_wood", enchLogs);
        enchLogItem = enchLogItem.setHiddenComponents("enchantments");
        enchLogItem = enchLogItem.addEnchant("sharpness", 1);
        enchLogItem = enchLogItem.setName(s"");
        enchLogItem = enchLogItem.setTooltipVisible(tooltip = "Disable");

        line hyperEnchLogItem = item("stripped_spruce_wood", hyperEnchLogs);
        hyperEnchLogItem = hyperEnchLogItem.setHiddenComponents("enchantments");
        hyperEnchLogItem = hyperEnchLogItem.addEnchant("sharpness", 1);
        hyperEnchLogItem = hyperEnchLogItem.setName(s"");
        hyperEnchLogItem = hyperEnchLogItem.setTooltipVisible(tooltip = "Disable");


        line hyperEnch2LogItem = item("stripped_cherry_wood", hyperEnch2Logs);
        hyperEnch2LogItem = hyperEnch2LogItem.setHiddenComponents("enchantments");
        hyperEnch2LogItem = hyperEnch2LogItem.addEnchant("sharpness", 1);
        hyperEnch2LogItem = hyperEnch2LogItem.setName(s"");
        hyperEnch2LogItem = hyperEnch2LogItem.setTooltipVisible(tooltip = "Disable");


        line hyperEnch3LogItem = item("stripped_warped_stem", hyperEnch3Logs);
        hyperEnch3LogItem = hyperEnch3LogItem.setHiddenComponents("enchantments");
        hyperEnch3LogItem = hyperEnch3LogItem.addEnchant("sharpness", 1);
        hyperEnch3LogItem = hyperEnch3LogItem.setName(s"");
        hyperEnch3LogItem = hyperEnch3LogItem.setTooltipVisible(tooltip = "Disable");

        line slot = 2;
        if(hyperEnch3Logs > 1) {
            player.setItemInSlot(hyperEnch3LogItem, slot);
            slot++;
        }
        if(hyperEnch2Logs > 1) {
            player.setItemInSlot(hyperEnch2LogItem, slot);
            slot++;
        }
        if(hyperEnchLogs > 1) {
            player.setItemInSlot(hyperEnchLogItem, slot);
            slot++;
        }
        if(enchLogs > 1) {
            player.setItemInSlot(enchLogItem, slot);
            slot++;
        }
        if(basicLogs > 1) {
            player.setItemInSlot(basicLogItem, slot);
            slot++;
        }
    }
}
import util;

namespace trinket {
    schema: namespace {
        center: loc;
        name: str;
        localLogValueBonus: num = 0;
        globalLogValueBonus: num = 0;
        stats: dict[num] = {};
        shopWeight: num = 10;
        cost: num;
        icon: item;
    };
}

namespace trinket.helix {
    center = loc(5, 15, 94);
    name = "Helix";
    localLogValueBonus = 30;
    globalLogValueBonus = 10;
    stats: dict[num] = {
        "sweep": 3,
        "fortune": 2
    };
    shopWeight = 1;
    cost = 1_000_000_000;
    icon = item("acacia_wood");
}


namespace trinket {
    schema: namespace {
        center: loc;
        name: str;
        logValueBonus: num;
        stats: dict[num];
        shopWeight: num = 10;
    };
}

namespace trinket.helix {
    center = loc(5, 15, 94);
    name = "Helix";
    logValueBonus = 20;
    stats: dict[num] = {
        "sweep": 3,
        "fortune": 2
    };
    shopWeight = 1;
}

